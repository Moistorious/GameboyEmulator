{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Gameboy Emulator (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/main",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "preLaunchTask": "cargo build",
      "terminal": "integrated",
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Attach to Process (LLDB)",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickProcess}",
      "stopOnEntry": false
    },
    {
      "name": "Debug (cargo run)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/main",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo run",
      "terminal": "integrated",
      "sourceLanguages": ["rust"]
    }
  ]
}